# انسخي الملف ده وسميه .env.local لو عايزة تجربي محليًا.
# على Vercel، القيم الحقيقية بتتحط من الموقع (Settings > Environment Variables) مش من هنا،
# وبعد إضافتها/تعديلها لازم تعملي Redeploy عشان تتفعّل.
ADMIN_PASSWORD=CHANGE_ME

# لوحة التحكم فقط (إضافة/تعديل/حذف تصميمات، تحديث السعر، عرض الطلبات) بتحتاج المفتاح ده.
# ده مفتاح سري بيدّي صلاحية كاملة على قاعدة البيانات - أبدًا متحطيهوش في كود بيتبعت للمتصفح أو GitHub.
# تلاقيه في Supabase: Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
SUPABASE_URL=https://npofzcmylmnepseedxvb.supabase.co
